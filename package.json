{
  "name": "@prostriveorg/ui",
  "version": "0.1.0",
  "description": "ProStrive shared live dynamic-analysis UI: paired signal plot, channel grid, insole field, movement sensors and recording status.",
  "license": "UNLICENSED",
  "author": "ProStrive",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/prostriveorg/ui.git"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/types/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./dynamic": {
      "types": "./dist/types/dynamic/index.d.ts",
      "import": "./dist/dynamic.js"
    },
    "./dynamic/data": {
      "types": "./dist/types/dynamic/data.d.ts",
      "import": "./dist/dynamic-data.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-fonts.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "check": "yarn build && yarn typecheck && yarn lint && yarn format:check && yarn test",
    "verify:pack": "node scripts/verify-pack.mjs",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "browser:check": "node scripts/browser-check.mjs",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/saira": "5.3.0",
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "playwright-core": "^1.56.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "peerDependencies": {
    "@mantine/core": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
